    replacement_chunks {
      replacement_content: "package com.example.data.api\n\nimport com.example.data.model.*\nimport retrofit2.http.*\n\ninterface MediReminderApiService {\n\n    @POST(\"api/auth/login\")\n    suspend fun login(@Body request: AuthRequest): AuthResponse\n\n    @POST(\"api/auth/google\")\n    suspend fun googleLogin(@Body request: AuthRequest): AuthResponse\n\n    @POST(\"api/auth/apple\")\n    suspend fun appleLogin(@Body request: AuthRequest): AuthResponse\n\n    // Medicines\n    @GET(\"api/medicines\")\n    suspend fun getMedicines(@Header(\"Authorization\") token: String): List<Medicine>\n\n    @POST(\"api/medicines\")\n    suspend fun addMedicine(\n        @Header(\"Authorization\") token: String,\n        @Body medicine: Medicine\n    ): Medicine\n\n    @DELETE(\"api/medicines/{id}\")\n    suspend fun deleteMedicine(\n        @Header(\"Authorization\") token: String,\n        @Path(\"id\") id: Int\n    ): Map<String, Boolean>\n\n    // Reminders\n    @GET(\"api/reminders\")\n    suspend fun getReminders(\n        @Header(\"Authorization\") token: String,\n        @Query(\"date\") date: String\n    ): List<ReminderItem>\n\n    @PUT(\"api/reminders/{id}\")\n    suspend fun updateReminder(\n        @Header(\"Authorization\") token: String,\n        @Path(\"id\") id: Int,\n        @Query(\"status\") status: String,\n        @Query(\"actionTimeMs\") actionTimeMs: Long\n    ): ReminderItem\n\n    // Payments\n    @POST(\"api/payments/payu/initiate\")\n    suspend fun initiatePayment(\n        @Header(\"Authorization\") token: String,\n        @Body request: PayUInitiateRequest\n    ): PayUResponse\n\n    // Family Members\n    @GET(\"api/family-members\")\n    suspend fun getFamilyMembers(@Header(\"Authorization\") token: String): List<FamilyMember>\n\n    @POST(\"api/family-members\")\n    suspend fun addFamilyMember(\n        @Header(\"Authorization\") token: String,\n        @Body member: FamilyMember\n    ): FamilyMember\n\n    // Admin Configurations & Notifications\n    @GET(\"api/admin/config\")\n    suspend fun getAdminConfig(): AdminConfig\n}\n"
    }
